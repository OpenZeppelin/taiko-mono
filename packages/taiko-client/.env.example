###############################################################################
# REQUIRED VARIABLES - DRIVER (NODE OPERATOR)
###############################################################################

# The WebSocket endpoint for your L1 Ethereum node
# Must be a WebSocket URL starting with "ws://" or "wss://"
# Example: wss://holesky.infura.io/ws/v3/YOUR_API_KEY
export L1_WS=ws://127.0.0.1:8545

# The HTTP endpoint for your L1 Ethereum beacon node
# Required for blob data and slot-based pre-confirmation features
# We are hardcoding a mainnet RPC for now, but should use a local client
# Example: https://holesky-beacon.infura.io/eth/v1
export L1_BEACON=https://ethereum-beacon-api.publicnode.com


# The WebSocket endpoint for your local Taiko L2 node (taiko-geth)
# Typically a local connection when running your own node
# Example: ws://localhost:28546
export L2_WS=ws://127.0.0.1:28546

# The HTTP endpoint for your local Taiko L2 node (taiko-geth)
# Typically a local connection when running your own node
# Example: http://localhost:28545
export L2_HTTP=http://127.0.0.1:28545

# The authenticated RPC endpoint for the L2 execution engine
# This is the Engine API endpoint used for consensus operations
# Example: http://localhost:28551
export L2_AUTH=http://127.0.0.1:28551

# Path to the JWT secret file for authenticating with L2 engine API
# Must be a valid hex string (64 characters)
# Example: ./jwt.txt
export JWT_SECRET=./jwt.txt

# Address of the inbox
export INBOX=<YOUR_INBOX_ADDRESS>

# Address of the Inbox contract
# This is Taiko's deployment on Holesky(https://docs.taiko.xyz/network-reference/hekla-addresses)
export TAIKO_INBOX=0x79C9109b764609df928d16fC4a91e9081F7e87DB

#Address of the Anchor contract
# This is Taiko's deployment on Hekla(https://docs.taiko.xyz/network-reference/hekla-addresses)
export TAIKO_ANCHOR=0x1670090000000000000000000000000000010001

# Address of our minimal rollup checkpoint tracker
export CHECKPOINT_TRACKER=<CHECKPOINT_TRACKER_ADDRESS>


###############################################################################
# OPTIONAL VARIABLES - DRIVER (NODE OPERATOR)
###############################################################################

# # Verbosity level for logging (0=silent, 1=error, 2=warn, 3=info, 4=debug, 5=detail)
# # Default: 3
# VERBOSITY=3

# # Enable JSON formatting for logs
# # Default: false
# LOG_JSON=false

# # Enable metrics collection and reporting
# # Default: false
# METRICS=false

# # Metrics reporting server listening address
# # Default: 0.0.0.0
# METRICS_ADDR=0.0.0.0

# # Metrics reporting server listening port
# # Default: 6060
# METRICS_PORT=6060

# # Enable P2P syncing for faster initial sync
# # Default: false
# P2P_SYNC=true

# # Timeout for P2P syncing in seconds
# # Default: 3600 (1 hour)
# P2P_SYNC_TIMEOUT=3600s

# # URL for checkpoint sync to speed up initial syncing
# # Example for Hekla: https://rpc.hekla.taiko.xyz
# P2P_CHECK_POINT_SYNC_URL=

